{
  "name": "taskmanager",
  "version": "0.0.0",
  "private": true,
  "license": "MIT",
  "description": "End-to-end sample of zod-dynamodb: the zodapp task manager demo on DynamoDB",
  "scripts": {
    "infra:up": "tsx scripts/infra.mts up",
    "infra:down": "tsx scripts/infra.mts down",
    "mail": "tsx scripts/mail-recorder.mts",
    "dev": "concurrently -k -n server,web -c blue,green \"pnpm dev:server\" \"pnpm dev:web\"",
    "dev:server": "tsx watch --clear-screen=false src/server/main.ts",
    "dev:web": "vite",
    "build": "vite build",
    "check-types": "tsc --noEmit && tsc -p tsconfig.server.json --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "e2e": "playwright test"
  },
  "dependencies": {
    "@aws-sdk/client-dynamodb": "^3.1159.0",
    "@aws-sdk/client-s3": "^3.1159.0",
    "@aws-sdk/s3-request-presigner": "^3.1159.0",
    "@mantine/code-highlight": "^9.6.3",
    "@mantine/core": "^9.6.3",
    "@mantine/dates": "^9.6.3",
    "@mantine/dropzone": "^9.6.3",
    "@mantine/hooks": "^9.6.3",
    "@tabler/icons-react": "^3.36.1",
    "@tanstack/react-form": "^1.33.1",
    "@tanstack/react-router": "^1.157.18",
    "@zodapp/caching-utilities": "workspace:*",
    "@zodapp/react-storage": "workspace:*",
    "@zodapp/zod-dynamodb": "workspace:*",
    "@zodapp/zod-dynamodb-client": "workspace:*",
    "@zodapp/zod-dynamodb-express": "workspace:*",
    "@zodapp/zod-dynamodb-mqtt": "workspace:*",
    "@zodapp/zod-dynamodb-node": "workspace:*",
    "@zodapp/zod-dynamodb-react": "workspace:*",
    "@zodapp/zod-dynamodb-realtime": "workspace:*",
    "@zodapp/zod-extendable": "workspace:*",
    "@zodapp/zod-form": "workspace:*",
    "@zodapp/zod-form-dynamodb": "workspace:*",
    "@zodapp/zod-form-mantine": "workspace:*",
    "@zodapp/zod-form-react": "workspace:*",
    "@zodapp/zod-form-s3": "workspace:*",
    "@zodapp/zod-form-s3-node": "workspace:*",
    "@zodapp/zod-form-widget": "workspace:*",
    "@zodapp/zod-searchparams": "workspace:*",
    "@zodapp/zod-tabular": "workspace:*",
    "aedes": "^1.2.0",
    "aws-amplify": "^6.16.0",
    "express": "^5.1.0",
    "jose": "^6.1.0",
    "lodash": "^4.17.21",
    "mingo": "^7.2.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "shiki": "^3.22.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@aws-sdk/client-cognito-identity-provider": "^3.1159.0",
    "@playwright/test": "1.63.0",
    "@repo/eslint-config": "workspace:*",
    "@repo/typescript-config": "workspace:*",
    "@types/express": "^5.0.3",
    "@types/lodash": "^4.17.20",
    "@types/mailparser": "^3.4.6",
    "@types/node": "^22.19.7",
    "@types/react": "^19.2.3",
    "@types/react-dom": "^19.2.3",
    "@types/smtp-server": "^3.5.12",
    "@vitejs/plugin-react": "^5.1.3",
    "concurrently": "^9.2.1",
    "eslint": "^9.34.0",
    "mailparser": "^3.7.4",
    "smtp-server": "^3.14.0",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vite": "^7.3.1",
    "vitest": "^4.0.18"
  }
}
