{
  "name": "@zodapp/zod-form-widget",
  "version": "0.0.0",
  "private": false,
  "description": "Reusable UI widgets for zod-form (AutoTable, AutoForm, TabularModal, etc.)",
  "author": "zodapp",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/zodapp/zodapp.git",
    "directory": "packages/zod-form-widget"
  },
  "homepage": "https://github.com/zodapp/zodapp/tree/main/packages/zod-form-widget#readme",
  "bugs": {
    "url": "https://github.com/zodapp/zodapp/issues"
  },
  "keywords": [
    "zod",
    "form",
    "table",
    "mantine",
    "react",
    "ui"
  ],
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public"
  },
  "sideEffects": [
    "*.css"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.cjs"
      }
    },
    "./table": {
      "import": {
        "types": "./dist/table/index.d.mts",
        "default": "./dist/table/index.mjs"
      },
      "require": {
        "types": "./dist/table/index.d.ts",
        "default": "./dist/table/index.cjs"
      }
    },
    "./tabular": {
      "import": {
        "types": "./dist/tabular/index.d.mts",
        "default": "./dist/tabular/index.mjs"
      },
      "require": {
        "types": "./dist/tabular/index.d.ts",
        "default": "./dist/tabular/index.cjs"
      }
    },
    "./form": {
      "import": {
        "types": "./dist/form/index.d.mts",
        "default": "./dist/form/index.mjs"
      },
      "require": {
        "types": "./dist/form/index.d.ts",
        "default": "./dist/form/index.cjs"
      }
    },
    "./feedback": {
      "import": {
        "types": "./dist/feedback/index.d.mts",
        "default": "./dist/feedback/index.mjs"
      },
      "require": {
        "types": "./dist/feedback/index.d.ts",
        "default": "./dist/feedback/index.cjs"
      }
    },
    "./styles.css": "./dist/styles.css",
    "./styles.layer.css": "./dist/styles.layer.css",
    "./messages": {
      "import": {
        "types": "./dist/messages/index.d.mts",
        "default": "./dist/messages/index.mjs"
      },
      "require": {
        "types": "./dist/messages/index.d.ts",
        "default": "./dist/messages/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "README.ja.md",
    "LICENSE"
  ],
  "scripts": {
    "lint": "eslint .",
    "build": "tsup",
    "watch": "tsup --watch --no-clean",
    "check-types": "tsc --noEmit",
    "clean": "rimraf dist .turbo node_modules",
    "test": "vitest run",
    "test:watch": "vitest --watch",
    "docs:typedoc": "node ../../tools/gen-typedoc.mjs"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@tabler/icons-react": "^3.36.1",
    "@tanstack/react-virtual": "^3.14.26",
    "@zodapp/i18n-messages": "workspace:*",
    "@zodapp/i18n-messages-react": "workspace:*",
    "@zodapp/i18n-messages-zod": "workspace:*",
    "@zodapp/zod-form": "workspace:*",
    "@zodapp/zod-form-mantine": "workspace:*",
    "@zodapp/zod-form-react": "workspace:*",
    "@zodapp/zod-tabular": "workspace:*",
    "lodash": "^4.17.21",
    "zod": "^4.4.3"
  },
  "peerDependencies": {
    "@mantine/core": "^8.2.7 || ^9.0.0",
    "@mantine/dates": "^8.2.7 || ^9.0.0",
    "@mantine/dropzone": "^8.2.7 || ^9.0.0",
    "@mantine/hooks": "^8.2.7 || ^9.0.0",
    "@tanstack/react-form": "^1.33.1",
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0"
  },
  "devDependencies": {
    "@mantine/dates": "^9.6.3",
    "@mantine/dropzone": "^9.6.3",
    "@repo/eslint-config": "workspace:*",
    "@repo/typescript-config": "workspace:*",
    "@testing-library/react": "^16.3.3",
    "@types/lodash": "^4.17.20",
    "@types/node": "^22.19.7",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^9.34.0",
    "jsdom": "^30.1.3",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "rimraf": "^6.1.2",
    "tslib": "^2.8.1",
    "tsup": "^8.5.1",
    "typescript": "^5.9.2",
    "vitest": "^4.0.18"
  },
  "volta": {
    "extends": "../../package.json"
  }
}
