{
  "name": "@zodapp/zod-form-s3-node",
  "version": "0.0.0",
  "private": false,
  "description": "Server side of @zodapp/zod-form-s3: presigned S3 URLs behind an authorized Express router",
  "license": "MIT",
  "keywords": [
    "zod",
    "s3",
    "form",
    "upload",
    "express"
  ],
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "scripts": {
    "build": "tsup",
    "lint": "eslint .",
    "check-types": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest --watch"
  },
  "peerDependencies": {
    "@aws-sdk/client-s3": "^3.700.0",
    "@aws-sdk/s3-request-presigner": "^3.700.0",
    "express": "^5.0.0"
  },
  "devDependencies": {
    "@aws-sdk/client-s3": "^3.1159.0",
    "@aws-sdk/s3-request-presigner": "^3.1159.0",
    "@repo/eslint-config": "workspace:*",
    "@repo/typescript-config": "workspace:*",
    "@types/express": "^5.0.0",
    "@types/node": "^22.19.7",
    "eslint": "^9.34.0",
    "express": "^5.1.0",
    "tsup": "^8.5.1",
    "vitest": "^4.0.18"
  },
  "dependencies": {
    "@zodapp/zod-form-s3": "workspace:*",
    "zod": "^4.4.3"
  }
}
