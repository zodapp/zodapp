{
  "name": "@zodapp/zod-form-mantine",
  "version": "0.0.0",
  "private": false,
  "description": "Mantine UI components for zod-form",
  "author": "zodapp",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/zodapp/zodapp.git",
    "directory": "packages/zod-form-mantine"
  },
  "homepage": "https://github.com/zodapp/zodapp/tree/main/packages/zod-form-mantine#readme",
  "bugs": {
    "url": "https://github.com/zodapp/zodapp/issues"
  },
  "keywords": [
    "zod",
    "form",
    "mantine",
    "react",
    "ui"
  ],
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public"
  },
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.cjs"
      }
    },
    "./components": {
      "import": {
        "types": "./dist/components/index.d.mts",
        "default": "./dist/components/index.mjs"
      },
      "require": {
        "types": "./dist/components/index.d.ts",
        "default": "./dist/components/index.cjs"
      }
    },
    "./components/*": {
      "import": {
        "types": "./dist/components/*.d.mts",
        "default": "./dist/components/*.mjs"
      },
      "require": {
        "types": "./dist/components/*.d.ts",
        "default": "./dist/components/*.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "README.ja.md",
    "LICENSE"
  ],
  "scripts": {
    "lint": "eslint .",
    "build": "tsup",
    "watch": "tsup --watch --no-clean",
    "check-types": "tsc --noEmit",
    "clean": "rimraf dist .turbo node_modules",
    "test": "vitest run",
    "test:watch": "vitest --watch",
    "docs:typedoc": "node ../../tools/gen-typedoc.mjs"
  },
  "devDependencies": {
    "@mantine/dates": "^9.6.3",
    "@mantine/dropzone": "^9.6.3",
    "@repo/eslint-config": "workspace:*",
    "@repo/typescript-config": "workspace:*",
    "@testing-library/react": "^16.0.1",
    "@testing-library/user-event": "^14.6.10",
    "@types/jsdom": "^27.0.0",
    "@types/node": "^22.19.7",
    "@types/react": "^19.3.0",
    "@types/react-is": "^19.2.0",
    "eslint": "^9.34.0",
    "jsdom": "^28.0.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "rimraf": "^6.1.2",
    "tslib": "^2.8.1",
    "tsup": "^8.5.1",
    "typescript": "^5.9.2",
    "vitest": "^4.0.18"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@tabler/icons-react": "^3.36.1",
    "@zodapp/zod-form": "workspace:*",
    "@zodapp/zod-form-mantine-lite": "workspace:*",
    "@zodapp/zod-form-react": "workspace:*",
    "dayjs": "^1.11.19",
    "lodash": "^4.17.21",
    "react-is": "^19.2.4",
    "zod": "^4.4.3"
  },
  "peerDependencies": {
    "@mantine/core": "^8.2.7 || ^9.0.0",
    "@mantine/dates": "^8.2.7 || ^9.0.0",
    "@mantine/dropzone": "^8.2.7 || ^9.0.0",
    "@mantine/hooks": "^8.2.7 || ^9.0.0",
    "@tanstack/react-form": "^1.33.1",
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0"
  },
  "volta": {
    "extends": "../../package.json"
  }
}
