{
  "name": "@zodapp/zod-form-react",
  "version": "0.0.0",
  "private": false,
  "description": "React bindings for zod-form",
  "author": "zodapp",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/zodapp/zodapp.git",
    "directory": "packages/zod-form-react"
  },
  "homepage": "https://github.com/zodapp/zodapp/tree/main/packages/zod-form-react#readme",
  "bugs": {
    "url": "https://github.com/zodapp/zodapp/issues"
  },
  "keywords": [
    "zod",
    "form",
    "react",
    "validation"
  ],
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public"
  },
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.cjs"
      }
    },
    "./common": {
      "import": {
        "types": "./dist/common/index.d.mts",
        "default": "./dist/common/index.mjs"
      },
      "require": {
        "types": "./dist/common/index.d.ts",
        "default": "./dist/common/index.cjs"
      }
    },
    "./media": {
      "import": {
        "types": "./dist/media/index.d.mts",
        "default": "./dist/media/index.mjs"
      },
      "require": {
        "types": "./dist/media/index.d.ts",
        "default": "./dist/media/index.cjs"
      }
    },
    "./media/types": {
      "import": {
        "types": "./dist/media/types.d.mts",
        "default": "./dist/media/types.mjs"
      },
      "require": {
        "types": "./dist/media/types.d.ts",
        "default": "./dist/media/types.cjs"
      }
    },
    "./mediaResolvers": {
      "import": {
        "types": "./dist/mediaResolvers/index.d.mts",
        "default": "./dist/mediaResolvers/index.mjs"
      },
      "require": {
        "types": "./dist/mediaResolvers/index.d.ts",
        "default": "./dist/mediaResolvers/index.cjs"
      }
    },
    "./def": {
      "import": {
        "types": "./dist/def/index.d.mts",
        "default": "./dist/def/index.mjs"
      },
      "require": {
        "types": "./dist/def/index.d.ts",
        "default": "./dist/def/index.cjs"
      }
    },
    "./utils/dateConverter": {
      "import": {
        "types": "./dist/utils/dateConverter.d.mts",
        "default": "./dist/utils/dateConverter.mjs"
      },
      "require": {
        "types": "./dist/utils/dateConverter.d.ts",
        "default": "./dist/utils/dateConverter.cjs"
      }
    },
    "./utils/timeConverter": {
      "import": {
        "types": "./dist/utils/timeConverter.d.mts",
        "default": "./dist/utils/timeConverter.mjs"
      },
      "require": {
        "types": "./dist/utils/timeConverter.d.ts",
        "default": "./dist/utils/timeConverter.cjs"
      }
    },
    "./utils/externalKey": {
      "import": {
        "types": "./dist/utils/externalKey.d.mts",
        "default": "./dist/utils/externalKey.mjs"
      },
      "require": {
        "types": "./dist/utils/externalKey.d.ts",
        "default": "./dist/utils/externalKey.cjs"
      }
    },
    "./messages": {
      "import": {
        "types": "./dist/messages/index.d.mts",
        "default": "./dist/messages/index.mjs"
      },
      "require": {
        "types": "./dist/messages/index.d.ts",
        "default": "./dist/messages/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "README.ja.md",
    "LICENSE"
  ],
  "scripts": {
    "lint": "eslint .",
    "build": "tsup",
    "watch": "tsup --watch --no-clean",
    "check-types": "tsc --noEmit",
    "clean": "rimraf dist .turbo node_modules",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest --watch",
    "docs:typedoc": "node ../../tools/gen-typedoc.mjs"
  },
  "devDependencies": {
    "@repo/eslint-config": "workspace:*",
    "@repo/typescript-config": "workspace:*",
    "@types/node": "^22.19.7",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^9.34.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "rimraf": "^6.1.2",
    "tslib": "^2.8.1",
    "tsup": "^8.5.1",
    "typescript": "^5.9.2",
    "vitest": "^4.0.18"
  },
  "dependencies": {
    "@zodapp/caching-utilities": "workspace:*",
    "@zodapp/i18n-messages": "workspace:*",
    "@zodapp/i18n-messages-react": "workspace:*",
    "@zodapp/i18n-messages-zod": "workspace:*",
    "@zodapp/zod-extendable": "workspace:*",
    "@zodapp/zod-form": "workspace:*",
    "@zodapp/zod-propagating-registry": "workspace:*",
    "@zodapp/zod-transform": "workspace:*",
    "dayjs": "^1.11.13",
    "zod": "^4.4.3"
  },
  "peerDependencies": {
    "@tanstack/react-form": "^1.33.1",
    "react": "^18.0.0 || ^19.0.0"
  },
  "volta": {
    "extends": "../../package.json"
  }
}
