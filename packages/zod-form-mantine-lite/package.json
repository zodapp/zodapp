{
  "name": "@zodapp/zod-form-mantine-lite",
  "version": "0.0.0",
  "private": false,
  "description": "Mantine UI components for zod-form (TanStack-free)",
  "author": "zodapp",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/zodapp/zodapp.git",
    "directory": "packages/zod-form-mantine-lite"
  },
  "homepage": "https://github.com/zodapp/zodapp/tree/main/packages/zod-form-mantine-lite#readme",
  "bugs": {
    "url": "https://github.com/zodapp/zodapp/issues"
  },
  "keywords": [
    "zod",
    "form",
    "mantine",
    "react",
    "ui"
  ],
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public"
  },
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.cjs"
      }
    },
    "./baseComponents": {
      "import": {
        "types": "./dist/baseComponents/index.d.mts",
        "default": "./dist/baseComponents/index.mjs"
      },
      "require": {
        "types": "./dist/baseComponents/index.d.ts",
        "default": "./dist/baseComponents/index.cjs"
      }
    },
    "./baseComponents/*": {
      "import": {
        "types": "./dist/baseComponents/*.d.mts",
        "default": "./dist/baseComponents/*.mjs"
      },
      "require": {
        "types": "./dist/baseComponents/*.d.ts",
        "default": "./dist/baseComponents/*.cjs"
      }
    },
    "./tableComponents": {
      "import": {
        "types": "./dist/tableComponents/index.d.mts",
        "default": "./dist/tableComponents/index.mjs"
      },
      "require": {
        "types": "./dist/tableComponents/index.d.ts",
        "default": "./dist/tableComponents/index.cjs"
      }
    },
    "./tableComponents/*": {
      "import": {
        "types": "./dist/tableComponents/*.d.mts",
        "default": "./dist/tableComponents/*.mjs"
      },
      "require": {
        "types": "./dist/tableComponents/*.d.ts",
        "default": "./dist/tableComponents/*.cjs"
      }
    },
    "./reactiveComponents": {
      "import": {
        "types": "./dist/reactiveComponents/index.d.mts",
        "default": "./dist/reactiveComponents/index.mjs"
      },
      "require": {
        "types": "./dist/reactiveComponents/index.d.ts",
        "default": "./dist/reactiveComponents/index.cjs"
      }
    },
    "./reactiveComponents/*": {
      "import": {
        "types": "./dist/reactiveComponents/*.d.mts",
        "default": "./dist/reactiveComponents/*.mjs"
      },
      "require": {
        "types": "./dist/reactiveComponents/*.d.ts",
        "default": "./dist/reactiveComponents/*.cjs"
      }
    },
    "./mediaResolvers": {
      "import": {
        "types": "./dist/mediaResolvers/index.d.mts",
        "default": "./dist/mediaResolvers/index.mjs"
      },
      "require": {
        "types": "./dist/mediaResolvers/index.d.ts",
        "default": "./dist/mediaResolvers/index.cjs"
      }
    },
    "./utils": {
      "import": {
        "types": "./dist/utils/index.d.mts",
        "default": "./dist/utils/index.mjs"
      },
      "require": {
        "types": "./dist/utils/index.d.ts",
        "default": "./dist/utils/index.cjs"
      }
    },
    "./messages": {
      "import": {
        "types": "./dist/messages/index.d.mts",
        "default": "./dist/messages/index.mjs"
      },
      "require": {
        "types": "./dist/messages/index.d.ts",
        "default": "./dist/messages/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "README.ja.md",
    "LICENSE"
  ],
  "scripts": {
    "lint": "eslint .",
    "build": "tsup",
    "watch": "tsup --watch --no-clean",
    "check-types": "tsc --noEmit",
    "clean": "rimraf dist .turbo node_modules",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest --watch",
    "docs:typedoc": "node ../../tools/gen-typedoc.mjs"
  },
  "devDependencies": {
    "@mantine/dates": "^9.6.3",
    "@repo/eslint-config": "workspace:*",
    "@repo/typescript-config": "workspace:*",
    "@types/node": "^22.19.7",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/react-is": "^19.2.0",
    "eslint": "^9.34.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "rimraf": "^6.1.2",
    "tslib": "^2.8.1",
    "tsup": "^8.5.1",
    "typescript": "^5.9.2",
    "vitest": "^4.0.18"
  },
  "dependencies": {
    "@tabler/icons-react": "^3.36.1",
    "@zodapp/i18n-messages": "workspace:*",
    "@zodapp/i18n-messages-react": "workspace:*",
    "@zodapp/zod-form": "workspace:*",
    "@zodapp/zod-form-react": "workspace:*",
    "dayjs": "^1.11.19",
    "react-is": "^19.2.4",
    "zod": "^4.4.3"
  },
  "peerDependencies": {
    "@mantine/core": "^8.2.7 || ^9.0.0",
    "@mantine/dates": "^8.2.7 || ^9.0.0",
    "@mantine/hooks": "^8.2.7 || ^9.0.0",
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0"
  },
  "volta": {
    "extends": "../../package.json"
  }
}
