{
  "name": "@zodapp/zod-dynamodb-realtime",
  "version": "0.0.0",
  "private": false,
  "description": "WebSocket realtime gateway for @zodapp/zod-dynamodb subscriptions",
  "license": "MIT",
  "keywords": [
    "zod",
    "dynamodb",
    "websocket",
    "realtime"
  ],
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "scripts": {
    "build": "tsup",
    "lint": "eslint .",
    "check-types": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest --watch"
  },
  "devDependencies": {
    "@aws-sdk/client-dynamodb": "^3.1159.0",
    "@repo/eslint-config": "workspace:*",
    "@repo/typescript-config": "workspace:*",
    "@types/node": "^22.19.7",
    "@types/ws": "^8.18.2",
    "@zodapp/zod-dynamodb-mqtt": "workspace:*",
    "aedes": "^1.2.0",
    "eslint": "^9.34.0",
    "tsup": "^8.5.1",
    "vitest": "^4.0.18"
  },
  "dependencies": {
    "@zodapp/zod-dynamodb": "workspace:*",
    "@zodapp/zod-dynamodb-node": "workspace:*",
    "ws": "^8.22.1",
    "zod": "^4.4.3"
  }
}
